{%- liquid
  assign section_st = section.settings
  assign enable_login_popup = section_st.enable_login_popup
  assign routes_login = routes.account_login_url
  assign login_one_time = true
  if routes_login contains 'login'
    assign login_one_time = false
  endif
-%}
{% # theme-check-disable UnclosedHTMLElement %}
{% if type != 'header_mega' %}
  <div class="header_account block-1025">
    {% if customer %}
      <div aria-label="header icon account" class="btn-reset pointer header-icon header-color w-44 h-44 inline-flex content-center header__icon-account header-color {% if customer.email == blank %}action-login{% endif %}">
    {% else %}
      {%- if enable_login_popup and login_one_time == false -%}
        <button aria-label="account" class="btn-reset pointer action-login-popup header-icon transition header-color w-44 h-44 inline-flex content-center header__icon-account header-color">
      {%- else -%}
        <a href="/pages/wholesale-signup" data-wholesale-guest-link aria-label="account" class="btn-reset pointer header-icon transition header-color w-44 h-44 inline-flex content-center header__icon-account header-color lh-1">
      {%- endif -%}
    {% endif %}
    {%- if customer -%}
      <a class="header-color lh-1" href="{{ routes.account_url }}" aria-label="{{ 'customer.account.title' | t }}">
    {%- endif -%}
    <svg width="26" height="26" fill="none" viewBox="0 0 24 24"><use href="#icon-account" /></svg>
    {%- if customer -%}</a>{%- endif -%}
    {%- if customer -%}</div>{%- else -%}{%- if enable_login_popup and login_one_time == false -%}</button>{%- else -%}</a>{%- endif -%}{%- endif -%}
  </div>
{% else %}
  <div class="header_account hidden block-1025">
    {% if customer %}
      <div aria-label="header icon account" class="btn-reset pointer header-icon header-color h-44 inline-flex content-center header__icon-account header-color {% if customer.email == blank %}action-login{% endif %}">
    {% else %}
      {%- if enable_login_popup and login_one_time == false -%}
        <button aria-label="account" class="btn-reset pointer action-login-popup header-icon transition header-color h-44 inline-flex content-center header__icon-account header-color">
      {%- else -%}
        <a aria-label="header icon account" href="/pages/wholesale-signup" data-wholesale-guest-link class="btn-reset pointer header-icon header-color h-44 inline-flex content-center header__icon-account header-color">
      {%- endif -%}
    {% endif %}
    {%- if customer -%}<a class="header-color header-icon lh-1" href="{{ routes.account_url }}" aria-label="{{ 'customer.account.title' | t }}">{%- endif -%}
    <svg width="26" height="26" fill="none" viewBox="0 0 24 24"><use href="#icon-account" /></svg>
    {%- if customer -%}</a>{%- endif -%}
    <span class="text-icons flex ps-12 text-left flex-column lh-1 1">
      <a class="no-underline mb-3" href="{%- if customer -%}{{ routes.account_logout_url }}{%- else -%}/pages/wholesale-signup{%- endif -%}" {% unless customer %}data-wholesale-guest-link{% endunless %} aria-label="{{ 'customer.account.title' | t }}">
        <span class="text-icons-top">{%- if customer -%}{{ 'customer.log_out' | t }}{%- else -%}<span data-wholesale-guest-label>Apply for Wholesale Access</span>{%- endif -%}</span>
      </a>
      <a class="no-underline text-icons-bottom" href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}" aria-label="{{ 'customer.account.title' | t }}">
        <span>{% if customer %}{{ 'customer.account.title' | t }}{% else %}Already registered? Log in{% endif %}</span>
      </a>
    </span>
    {%- if customer -%}</div>{%- else -%}{%- if enable_login_popup and login_one_time == false -%}</button>{%- else -%}</a>{%- endif -%}{%- endif -%}
  </div>
{% endif %}
{% # theme-check-disable UnclosedHTMLElement %}