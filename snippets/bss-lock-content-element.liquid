<script>
(function () {
  var wholesaleUrl = '/pages/wholesale-signup';
  var wholesaleLabel = 'Apply for Wholesale Access';

  function fixBssGuestPriceLinks() {
    var links = document.querySelectorAll('a.bss-lock-message-element-14054');
    links.forEach(function (link) {
      link.setAttribute('href', wholesaleUrl);
      link.textContent = wholesaleLabel;
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', fixBssGuestPriceLinks);
  } else {
    fixBssGuestPriceLinks();
  }

  var observer = new MutationObserver(function () {
    fixBssGuestPriceLinks();
  });

  observer.observe(document.documentElement, { childList: true, subtree: true, attributes: true, attributeFilter: ['href'] });
})();
</script>