{% doc %}
  @prompt
    Build a comprehensive B2B wholesale product page layout for a vinyl record distributor. The product information section should display the following in a clean, structured layout optimized for wholesale buyers:
    
    **Header block:**
    - Product image (large, prominent)
    - Album/Release title (product title)
    - Artist (metafield: custom.artist)
    - Brand/Vendor
    
    **Product specs table (two-column grid):**
    - Label (custom.label)
    - Format (custom.format)
    - Vinyl Color (custom.vinyl_color)
    - Number of LPs (custom.number_of_lps)
    - UPC (variant barcode)
    - SKU (variant SKU)
    - Release Date (custom.release_date)
    
    **B2B Pricing block (most prominent element, styled to stand out):**
    - Wholesale Price (variant price) — large, bold
    - MSRP / Suggested Retail Price (custom.msrp) — clearly labeled
    - Retail Margin % — calculated dynamically as ((MSRP - Wholesale) / MSRP × 100), displayed as e.g. "Retail Margin: 43%"
    
    **Order info block:**
    - Inventory status (in stock / out of stock)
    - Quantity available
    - Minimum Order Quantity (custom.minimum_order_quantity) — if set
    - Case Pack Quantity (custom.case_pack_quantity) — if set
    
    **Content blocks:**
    - Product description
    - Track Listing (custom.track_listing) — shown in a styled two-column side A / side B layout if multiline, with a section heading "Track Listing"
    
    All fields should only display if they have a value (conditional rendering). Use clean typography, clear section headings, subtle dividers between sections, and a premium editorial aesthetic suitable for a wholesale vinyl music distributor. The pricing block should use a highlighted background or border to draw immediate attention.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% assign selected_variant = product.selected_or_first_available_variant %}
{% assign msrp_metafield = product.metafields.custom.msrp %}
{% assign msrp_value = msrp_metafield.value %}
{% assign ai_b2b_product_form_id = 'b2b-product-form-' | append: section.id | append: '-' | append: ai_gen_id %}

{% style %}
  .ai-b2b-product-{{ai_gen_id}} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 1410px;
    background-color: {{ block.settings.background_color }};
    border-radius: {{ block.settings.border_radius }}px;
    padding: 0px 10px;
    margin: 0 auto;
  }

  .ai-b2b-product-header-{{ai_gen_id}} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    margin-bottom: 40px;
  }

  .ai-b2b-product-media-{{ai_gen_id}} {
    width: 100%;
    min-width: 0;
  }

  .ai-b2b-product-media-{{ai_gen_id}} .media-main-swiper,
  .ai-b2b-product-media-{{ai_gen_id}} .grid_scroll,
  .ai-b2b-product-media-{{ai_gen_id}} .stacked {
    border-radius: {{ block.settings.image_border_radius }}px;
    overflow: hidden;
  }

  .ai-b2b-product-media-{{ai_gen_id}} img {
    max-width: 100%;
  }

  .ai-b2b-product-placeholder-{{ai_gen_id}} {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f4f4f4;
  }

  .ai-b2b-product-placeholder-{{ai_gen_id}} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-b2b-product-info-{{ai_gen_id}} {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .ai-b2b-product-title-{{ai_gen_id}} {
    font-size: {{ block.settings.title_size }}px;
    font-weight: {{ block.settings.title_weight }};
    color: {{ block.settings.title_color }};
    margin: 0;
    line-height: 1.2;
  }

  .ai-b2b-product-artist-{{ai_gen_id}} {
    font-size: {{ block.settings.artist_size }}px;
    font-weight: {{ block.settings.artist_weight }};
    color: {{ block.settings.artist_color }};
    margin: 0;
  }

  .ai-b2b-product-vendor-{{ai_gen_id}} {
    font-size: {{ block.settings.vendor_size }}px;
    color: {{ block.settings.text_color }};
    opacity: 0.7;
  }

  .ai-b2b-product-specs-{{ai_gen_id}} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px 24px;
    padding: {{ block.settings.section_padding }}px;
    background-color: {{ block.settings.specs_background }};
    border-radius: {{ block.settings.section_border_radius }}px;
    margin-bottom: 24px;
  }

  .ai-b2b-product-specs-title-{{ai_gen_id}} {
    grid-column: 1 / -1;
    font-size: {{ block.settings.section_title_size }}px;
    font-weight: 600;
    color: {{ block.settings.title_color }};
    margin: 0 0 8px 0;
    padding-bottom: 12px;
    border-bottom: 1px solid {{ block.settings.divider_color }};
  }

  .ai-b2b-product-spec-item-{{ai_gen_id}} {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    font-size: {{ block.settings.text_size }}px;
  }

  .ai-b2b-product-spec-label-{{ai_gen_id}} {
    font-weight: 600;
    color: {{ block.settings.label_color }};
  }

  .ai-b2b-product-spec-value-{{ai_gen_id}} {
    color: {{ block.settings.text_color }};
    text-align: right;
  }

  .ai-b2b-product-pricing-{{ai_gen_id}} {
    padding: {{ block.settings.pricing_padding }}px;
    background: {{ block.settings.pricing_background }};
    border: 2px solid {{ block.settings.pricing_border_color }};
    border-radius: {{ block.settings.section_border_radius }}px;
    margin-bottom: 24px;
  }

  .ai-b2b-product-pricing-title-{{ai_gen_id}} {
    font-size: {{ block.settings.section_title_size }}px;
    font-weight: 600;
    color: {{ block.settings.title_color }};
    margin: 0 0 16px 0;
  }

  .ai-b2b-product-pricing-grid-{{ai_gen_id}} {
    display: grid;
    gap: 12px;
  }

  .ai-b2b-product-price-row-{{ai_gen_id}} {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
  }

  .ai-b2b-product-price-row-{{ai_gen_id}}[hidden] {
    display: none !important;
  }

  .ai-b2b-product-price-label-{{ai_gen_id}} {
    font-size: {{ block.settings.price_label_size }}px;
    font-weight: 500;
    color: {{ block.settings.label_color }};
  }

  .ai-b2b-product-wholesale-price-{{ai_gen_id}} {
    min-width: 0;
    text-align: right;
    font-size: {{ block.settings.wholesale_price_size }}px;
    font-weight: 700;
    color: {{ block.settings.wholesale_price_color }};
  }

  .ai-b2b-product-wholesale-price-{{ai_gen_id}} .price,
  .ai-b2b-product-wholesale-price-{{ai_gen_id}} .card-product-price {
    font-size: inherit;
    font-weight: inherit;
    color: inherit;
  }

  .ai-b2b-product-margin-row-{{ai_gen_id}} {
    margin-top: 4px;
  }

  .ai-b2b-product-purchase-{{ai_gen_id}} {
    margin-top: 24px;
  }

  .ai-b2b-product-purchase-{{ai_gen_id}} .product__submit-form,
  .ai-b2b-product-purchase-{{ai_gen_id}} .product-form,
  .ai-b2b-product-purchase-{{ai_gen_id}} .product-form__buttons {
    width: 100%;
  }

  .ai-b2b-product-purchase-{{ai_gen_id}} .product-form__buttons {
    align-items: stretch;
  }

  .ai-b2b-product-purchase-{{ai_gen_id}} .product__submit-form-cart {
    width: 100%;
  }

  .ai-b2b-product-msrp-{{ai_gen_id}} {
    font-size: {{ block.settings.msrp_size }}px;
    font-weight: 600;
    color: {{ block.settings.text_color }};
  }

  .ai-b2b-product-margin-{{ai_gen_id}} {
    font-size: {{ block.settings.margin_size }}px;
    font-weight: 600;
    color: {{ block.settings.margin_color }};
    padding: 8px 16px;
    background-color: {{ block.settings.margin_background }};
    border-radius: 4px;
    display: inline-block;
  }

  .ai-b2b-product-order-info-{{ai_gen_id}} {
    padding: {{ block.settings.section_padding }}px;
    background-color: {{ block.settings.specs_background }};
    border-radius: {{ block.settings.section_border_radius }}px;
    margin-bottom: 24px;
  }

  .ai-b2b-product-order-title-{{ai_gen_id}} {
    font-size: {{ block.settings.section_title_size }}px;
    font-weight: 600;
    color: {{ block.settings.title_color }};
    margin: 0 0 16px 0;
  }

  .ai-b2b-product-order-grid-{{ai_gen_id}} {
    display: grid;
    gap: 12px;
  }

  .ai-b2b-product-inventory-status-{{ai_gen_id}} {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: {{ block.settings.text_size }}px;
    font-weight: 600;
  }

  .ai-b2b-product-status-dot-{{ai_gen_id}} {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }

  .ai-b2b-product-status-in-stock-{{ai_gen_id}} {
    background-color: {{ block.settings.in_stock_color }};
  }

  .ai-b2b-product-status-out-stock-{{ai_gen_id}} {
    background-color: {{ block.settings.out_stock_color }};
  }

  .ai-b2b-product-description-{{ai_gen_id}} {
    padding: {{ block.settings.section_padding }}px;
    background-color: {{ block.settings.specs_background }};
    border-radius: {{ block.settings.section_border_radius }}px;
    margin-bottom: 24px;
  }

  .ai-b2b-product-description-title-{{ai_gen_id}} {
    font-size: {{ block.settings.section_title_size }}px;
    font-weight: 600;
    color: {{ block.settings.title_color }};
    margin: 0 0 16px 0;
  }

  .ai-b2b-product-description-content-{{ai_gen_id}} {
    font-size: {{ block.settings.text_size }}px;
    color: {{ block.settings.text_color }};
    line-height: 1.6;
  }

  .ai-b2b-product-tracklist-{{ai_gen_id}} {
    padding: {{ block.settings.section_padding }}px;
    background-color: {{ block.settings.specs_background }};
    border-radius: {{ block.settings.section_border_radius }}px;
  }

  .ai-b2b-product-tracklist-title-{{ai_gen_id}} {
    font-size: {{ block.settings.section_title_size }}px;
    font-weight: 600;
    color: {{ block.settings.title_color }};
    margin: 0 0 16px 0;
  }

  .ai-b2b-product-tracklist-grid-{{ai_gen_id}} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
  }

  .ai-b2b-product-tracklist-side-{{ai_gen_id}} {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .ai-b2b-product-side-label-{{ai_gen_id}} {
    font-size: {{ block.settings.text_size }}px;
    font-weight: 600;
    color: {{ block.settings.label_color }};
    margin-bottom: 4px;
  }

  .ai-b2b-product-track-{{ai_gen_id}} {
    font-size: {{ block.settings.text_size }}px;
    color: {{ block.settings.text_color }};
    line-height: 1.5;
  }

  @media screen and (max-width: 749px) {
    .ai-b2b-product-header-{{ai_gen_id}} {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .ai-b2b-product-media-{{ai_gen_id}} {
      width: 100%;
    }

    .ai-b2b-product-media-{{ai_gen_id}} .media-thumb-swiper {
      margin-top: 10px;
    }

    .ai-b2b-product-specs-{{ai_gen_id}} {
      grid-template-columns: 1fr;
    }

    .ai-b2b-product-tracklist-grid-{{ai_gen_id}} {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .ai-b2b-product-price-row-{{ai_gen_id}} {
      align-items: flex-start;
    }

    .ai-b2b-product-wholesale-price-{{ai_gen_id}},
    .ai-b2b-product-msrp-{{ai_gen_id}} {
      text-align: right;
      max-width: 65%;
    }
  }
{% endstyle %}

<div class="ai-b2b-product-{{ai_gen_id}}" {{ block.shopify_attributes }}>
  <div class="ai-b2b-product-header-{{ai_gen_id}}">
    <div class="ai-b2b-product-media-{{ai_gen_id}}">
      {% if product.media.size > 0 %}
        {% render 'media-gallery',
          images: product.media,
          section_st: section.settings,
          theme_st: settings,
          product: product,
          section: section,
          position_index: 0,
          desktop_layout: section.settings.desktop_layout
        %}
      {% else %}
        <div class="ai-b2b-product-placeholder-{{ai_gen_id}}">
          {{ 'product-1' | placeholder_svg_tag }}
        </div>
      {% endif %}
    </div>

    <div class="ai-b2b-product-info-{{ai_gen_id}}">
      <h1 class="ai-b2b-product-title-{{ai_gen_id}}">{{ product.title }}</h1>

      {% if product.metafields.custom.artist != blank %}
        <h2 class="ai-b2b-product-artist-{{ai_gen_id}}">{{ product.metafields.custom.artist }}</h2>
      {% endif %}

      {% if product.vendor != blank %}
        <div class="ai-b2b-product-vendor-{{ai_gen_id}}">{{ product.vendor }}</div>
      {% endif %}

  <div class="ai-b2b-product-pricing-{{ai_gen_id}}" data-b2b-pricing>
    <h3 class="ai-b2b-product-pricing-title-{{ai_gen_id}}">B2B Pricing</h3>
    <div class="ai-b2b-product-pricing-grid-{{ai_gen_id}}">
      <div class="ai-b2b-product-price-row-{{ai_gen_id}}">
        <span class="ai-b2b-product-price-label-{{ai_gen_id}}">Wholesale Price</span>
        <div class="ai-b2b-product-wholesale-price-{{ai_gen_id}}" data-b2b-wholesale-price>
          {% render 'price', scope: 'detail', product: product %}
        </div>
      </div>

      {% if msrp_metafield != blank and msrp_value != blank %}
        <div class="ai-b2b-product-price-row-{{ai_gen_id}}">
          <span class="ai-b2b-product-price-label-{{ai_gen_id}}">MSRP / Suggested Retail Price</span>
          <span
            class="ai-b2b-product-msrp-{{ai_gen_id}}"
            data-b2b-msrp
            data-b2b-msrp-amount="{{ msrp_value.amount | default: msrp_value }}"
          >
            {{ msrp_value | money }}
          </span>
        </div>

        <div
          class="ai-b2b-product-price-row-{{ai_gen_id}} ai-b2b-product-margin-row-{{ai_gen_id}}"
          data-b2b-margin-row
          hidden
        >
          <span class="ai-b2b-product-price-label-{{ai_gen_id}}">Retail Margin</span>
          <span class="ai-b2b-product-margin-{{ai_gen_id}}" data-b2b-margin-value></span>
        </div>
      {% endif %}
    </div>
  </div>


  <div class="ai-b2b-product-purchase-{{ai_gen_id}}" data-b2b-purchase-area>
    {% render 'buy-buttons',
      block: block,
      product: product,
      product_form_id: ai_b2b_product_form_id,
      section_id: section.id,
      show_quantity: block.settings.show_quantity,
      show_wishlist: false,
      show_compare: false,
      formClass: 'feature-product-form',
      type: 'main_product'
    %}
  </div>


    </div>
  </div>

  {% liquid
    assign has_specs = false
    if product.metafields.custom.label != blank or product.metafields.custom.format != blank or product.metafields.custom.vinyl_color != blank or product.metafields.custom.number_of_lps != blank or product.selected_or_first_available_variant.barcode != blank or product.selected_or_first_available_variant.sku != blank or product.metafields.custom.release_date != blank
      assign has_specs = true
    endif
  %}

  {% if has_specs %}
    <div class="ai-b2b-product-specs-{{ai_gen_id}}">
      <h3 class="ai-b2b-product-specs-title-{{ai_gen_id}}">Product Specifications</h3>

      {% if product.metafields.custom.label != blank %}
        <div class="ai-b2b-product-spec-item-{{ai_gen_id}}">
          <span class="ai-b2b-product-spec-label-{{ai_gen_id}}">Label</span>
          <span class="ai-b2b-product-spec-value-{{ai_gen_id}}">{{ product.metafields.custom.label }}</span>
        </div>
      {% endif %}

      {% if product.metafields.custom.format != blank %}
        <div class="ai-b2b-product-spec-item-{{ai_gen_id}}">
          <span class="ai-b2b-product-spec-label-{{ai_gen_id}}">Format</span>
          <span class="ai-b2b-product-spec-value-{{ai_gen_id}}">{{ product.metafields.custom.format }}</span>
        </div>
      {% endif %}

      {% if product.metafields.custom.vinyl_color != blank %}
        <div class="ai-b2b-product-spec-item-{{ai_gen_id}}">
          <span class="ai-b2b-product-spec-label-{{ai_gen_id}}">Vinyl Color</span>
          <span class="ai-b2b-product-spec-value-{{ai_gen_id}}">{{ product.metafields.custom.vinyl_color }}</span>
        </div>
      {% endif %}

      {% if product.metafields.custom.number_of_lps != blank %}
        <div class="ai-b2b-product-spec-item-{{ai_gen_id}}">
          <span class="ai-b2b-product-spec-label-{{ai_gen_id}}">Number of LPs</span>
          <span class="ai-b2b-product-spec-value-{{ai_gen_id}}">{{ product.metafields.custom.number_of_lps }}</span>
        </div>
      {% endif %}

      {% if product.selected_or_first_available_variant.barcode != blank %}
        <div class="ai-b2b-product-spec-item-{{ai_gen_id}}">
          <span class="ai-b2b-product-spec-label-{{ai_gen_id}}">UPC</span>
          <span class="ai-b2b-product-spec-value-{{ai_gen_id}}">{{ product.selected_or_first_available_variant.barcode }}</span>
        </div>
      {% endif %}

      {% if product.selected_or_first_available_variant.sku != blank %}
        <div class="ai-b2b-product-spec-item-{{ai_gen_id}}">
          <span class="ai-b2b-product-spec-label-{{ai_gen_id}}">SKU</span>
          <span class="ai-b2b-product-spec-value-{{ai_gen_id}}">{{ product.selected_or_first_available_variant.sku }}</span>
        </div>
      {% endif %}

      {% if product.metafields.custom.release_date != blank %}
        <div class="ai-b2b-product-spec-item-{{ai_gen_id}}">
          <span class="ai-b2b-product-spec-label-{{ai_gen_id}}">Release Date</span>
          <span class="ai-b2b-product-spec-value-{{ai_gen_id}}">{{ product.metafields.custom.release_date }}</span>
        </div>
      {% endif %}
    </div>
  {% endif %}

  <div class="ai-b2b-product-order-info-{{ai_gen_id}}">
    <h3 class="ai-b2b-product-order-title-{{ai_gen_id}}">Order Information</h3>
    <div class="ai-b2b-product-order-grid-{{ai_gen_id}}">
      <div class="ai-b2b-product-spec-item-{{ai_gen_id}}">
        <span class="ai-b2b-product-spec-label-{{ai_gen_id}}">Availability</span>
        <span class="ai-b2b-product-inventory-status-{{ai_gen_id}}">
          {% if product.selected_or_first_available_variant.available %}
            <span class="ai-b2b-product-status-dot-{{ai_gen_id}} ai-b2b-product-status-in-stock-{{ai_gen_id}}"></span>
            <span style="color: {{ block.settings.in_stock_color }};">In Stock</span>
          {% else %}
            <span class="ai-b2b-product-status-dot-{{ai_gen_id}} ai-b2b-product-status-out-stock-{{ai_gen_id}}"></span>
            <span style="color: {{ block.settings.out_stock_color }};">Out of Stock</span>
          {% endif %}
        </span>
      </div>

      {% if product.selected_or_first_available_variant.inventory_quantity > 0 %}
        <div class="ai-b2b-product-spec-item-{{ai_gen_id}}">
          <span class="ai-b2b-product-spec-label-{{ai_gen_id}}">Quantity Available</span>
          <span class="ai-b2b-product-spec-value-{{ai_gen_id}}">{{ product.selected_or_first_available_variant.inventory_quantity }}</span>
        </div>
      {% endif %}

      {% if product.metafields.custom.minimum_order_quantity != blank %}
        <div class="ai-b2b-product-spec-item-{{ai_gen_id}}">
          <span class="ai-b2b-product-spec-label-{{ai_gen_id}}">Minimum Order Quantity</span>
          <span class="ai-b2b-product-spec-value-{{ai_gen_id}}">{{ product.metafields.custom.minimum_order_quantity }}</span>
        </div>
      {% endif %}

      {% if product.metafields.custom.case_pack_quantity != blank %}
        <div class="ai-b2b-product-spec-item-{{ai_gen_id}}">
          <span class="ai-b2b-product-spec-label-{{ai_gen_id}}">Case Pack Quantity</span>
          <span class="ai-b2b-product-spec-value-{{ai_gen_id}}">{{ product.metafields.custom.case_pack_quantity }}</span>
        </div>
      {% endif %}
    </div>
  </div>

  {% if product.description != blank %}
    <div class="ai-b2b-product-description-{{ai_gen_id}}">
      <h3 class="ai-b2b-product-description-title-{{ai_gen_id}}">Description</h3>
      <div class="ai-b2b-product-description-content-{{ai_gen_id}}">
        {{ product.description }}
      </div>
    </div>
  {% endif %}

  {% if product.metafields.custom.track_listing != blank %}
    <div class="ai-b2b-product-tracklist-{{ai_gen_id}}">
      <h3 class="ai-b2b-product-tracklist-title-{{ai_gen_id}}">Track Listing</h3>

      {% assign tracks = product.metafields.custom.track_listing | newline_to_br | split: '<br />' %}
      {% assign track_count = tracks.size %}
      {% assign half_point = track_count | divided_by: 2.0 | ceil %}

      <div class="ai-b2b-product-tracklist-grid-{{ai_gen_id}}">
        <div class="ai-b2b-product-tracklist-side-{{ai_gen_id}}">
          <div class="ai-b2b-product-side-label-{{ai_gen_id}}">Side A</div>
          {% for track in tracks limit: half_point %}
            {% if track != blank %}
              <div class="ai-b2b-product-track-{{ai_gen_id}}">{{ track }}</div>
            {% endif %}
          {% endfor %}
        </div>

        {% if track_count > half_point %}
          <div class="ai-b2b-product-tracklist-side-{{ai_gen_id}}">
            <div class="ai-b2b-product-side-label-{{ai_gen_id}}">Side B</div>
            {% for track in tracks offset: half_point %}
              {% if track != blank %}
                <div class="ai-b2b-product-track-{{ai_gen_id}}">{{ track }}</div>
              {% endif %}
            {% endfor %}
          </div>
        {% endif %}
      </div>
    </div>
  {% endif %}
</div>


{% if msrp_metafield != blank and msrp_value != blank %}
  <script>
    (() => {
      const root = document.querySelector('.ai-b2b-product-{{ ai_gen_id }}');
      if (!root || root.dataset.b2bMarginReady === 'true') return;
      root.dataset.b2bMarginReady = 'true';

      const wholesale = root.querySelector('[data-b2b-wholesale-price]');
      const msrp = root.querySelector('[data-b2b-msrp]');
      const marginRow = root.querySelector('[data-b2b-margin-row]');
      const marginValue = root.querySelector('[data-b2b-margin-value]');

      if (!wholesale || !msrp || !marginRow || !marginValue) return;

      const moneyNumber = (value) => {
        if (!value) return null;
        const normalized = value
          .replace(/\s/g, '')
          .replace(/,/g, '')
          .replace(/[^0-9.\-]/g, '');
        const number = parseFloat(normalized);
        return Number.isFinite(number) ? number : null;
      };

      const wholesaleNumber = () => {
        // BSS can replace this area with a lock/login message. Never calculate
        // a margin unless an actual numeric price is currently rendered.
        const text = wholesale.textContent || '';
        const value = moneyNumber(text);
        return value && value > 0 ? value : null;
      };

      const updateMargin = () => {
        const msrpAmount = msrp.getAttribute('data-b2b-msrp-amount') || '';
        const retailPrice = moneyNumber(msrpAmount) || moneyNumber(msrp.textContent || '');
        const costPrice = wholesaleNumber();

        if (!retailPrice || !costPrice || retailPrice <= 0 || costPrice <= 0 || costPrice >= retailPrice) {
          marginRow.hidden = true;
          marginValue.textContent = '';
          return;
        }

        const margin = ((retailPrice - costPrice) / retailPrice) * 100;
        marginValue.textContent = (Math.round(margin * 10) / 10) + '%';
        marginRow.hidden = false;
      };

      updateMargin();

      new MutationObserver(updateMargin).observe(wholesale, {
        childList: true,
        subtree: true,
        characterData: true
      });

      document.addEventListener('variant:change', () => setTimeout(updateMargin, 100));
      setTimeout(updateMargin, 500);
      setTimeout(updateMargin, 1500);
    })();
  </script>
{% endif %}
